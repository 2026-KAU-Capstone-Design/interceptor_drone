    <!-- ROCKET_DRONE_AERODYNAMIC_MODEL -->
    <!-- 1차 검증 모델: X축 전진 시 동체 항력 -->
    <plugin
      filename="gz-sim-advanced-lift-drag-system"
      name="gz::sim::systems::AdvancedLiftDrag">

      <!-- 공력이 작용할 기체 링크 -->
      <link_name>base_link</link_name>

      <!-- 해수면 표준 공기밀도 [kg/m^3] -->
      <rho>1.225</rho>

      <!-- 호버 자세에서 X축 진행 방향 투영면적 [m^2] -->
      <area>0.05890</area>

      <!-- base_link 기준 전방축과 상방축 -->
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>

      <!-- 공력 작용점 [m] -->
      <!-- 1차 시험에서는 CG와 가깝게 설정하여 불필요한 모멘트 억제 -->
      <cp>0 0 0.027097</cp>

      <!-- 기본 공력계수 -->
      <CL0>0.0</CL0>
      <CD0>0.186</CD0>
      <Cem0>0.0</Cem0>

      <!-- 받음각 및 옆미끄럼각 계수 -->
      <CLa>1.89</CLa>
      <CYa>0.0</CYa>
      <Cella>0.0</Cella>
      <Cema>0.0</Cema>
      <Cena>0.0</Cena>

      <CLb>0.0</CLb>
      <CYb>0.0</CYb>
      <Cellb>0.0</Cellb>
      <Cemb>0.0</Cemb>
      <Cenb>0.0</Cenb>

      <!-- 회전 운동에 따른 공력 미분계수 -->
      <CDp>0.0</CDp>
      <CYp>0.0</CYp>
      <CLp>0.0</CLp>
      <Cellp>0.0</Cellp>
      <Cenp>0.0</Cenp>

      <CDq>0.0</CDq>
      <CYq>0.0</CYq>
      <CLq>0.0</CLq>
      <Cellq>0.0</Cellq>
      <Cemq>0.0</Cemq>
      <Cenq>0.0</Cenq>

      <CDr>0.0</CDr>
      <CYr>0.0</CYr>
      <CLr>0.0</CLr>
      <Cellr>0.0</Cellr>
      <Cemr>0.0</Cemr>
      <Cenr>0.0</Cenr>

      <!-- 기준 형상 -->
      <AR>1.0</AR>
      <mac>0.427817</mac>
      <eff>1.0</eff>

      <!-- 스톨 관련 값: 1차 항력 시험에서는 사실상 비활성 -->
      <alphaStall>1.5708</alphaStall>
      <CemaStall>0.0</CemaStall>

    </plugin>

  </model>
</sdf>
